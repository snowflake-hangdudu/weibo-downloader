{
  "manifest_version": 3,
  "name": "微博内容下载与备份助手",
  "version": "1.0.0",
  "description": "保存当前页面中用户可访问的公开内容。",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "offscreen",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://weibo.com/*",
    "https://www.weibo.com/*",
    "https://m.weibo.cn/*",
    "https://s.weibo.com/*",
    "https://*.sinaimg.cn/*",
    "https://*.weibocdn.com/*",
    "https://*.video.weibocdn.com/*",
    "https://f.video.weibocdn.com/*",
    "https://download-config-hub.nutmeg-venus-6882.chatgpt.site/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "weibo_cdn_headers",
        "enabled": true,
        "path": "rules/cdn-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weibo.com/*",
        "https://www.weibo.com/*",
        "https://m.weibo.cn/*",
        "https://s.weibo.com/*"
      ],
      "js": ["content/page-agent.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://weibo.com/*",
        "https://www.weibo.com/*",
        "https://m.weibo.cn/*",
        "https://s.weibo.com/*"
      ],
      "js": [
        "content/weibo-runtime.js",
        "content/weibo-dom.js",
        "content/weibo-remote-content.js",
        "content/weibo-media.js",
        "content/weibo-queue.js",
        "content/weibo-platform.js",
        "content/weibo-panel.js",
        "content/debug.js",
        "content/platform-adapter.js",
        "content/media-saver.js",
        "content/content.js"
      ],
      "css": ["content/weibo-panel.css", "content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "微博内容下载与备份助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": [
        "https://weibo.com/*",
        "https://www.weibo.com/*",
        "https://m.weibo.cn/*",
        "https://s.weibo.com/*"
      ]
    }
  ]
}
